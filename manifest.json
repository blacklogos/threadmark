{
  "manifest_version": 3,
  "name": "Threadmark",
  "version": "0.4.0",
  "description": "Turn threads into tools. Extract Threads posts to Markdown, HTML, or plain text — AI-ready in one click.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "*://*.threads.com/*",
    "*://*.threads.net/*",
    "*://*.fbcdn.net/*",
    "*://*.cdninstagram.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.threads.com/*",
        "*://*.threads.net/*"
      ],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
} 